{
  "cli": {
    "version": ">= 15.0.0"
  },
  "build": {
    "production": {
      "android": {
        "buildType": "apk",
        "image": "latest",
        "cache": {
          "disabled": false,
          "key": "v2-clean-native"
        }
      },
      "env": {
        "SENTRY_ORG": "mevento-nb",
        "SENTRY_PROJECT": "react-native",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "SENTRY_ORG": "mevento-nb",
        "SENTRY_PROJECT": "react-native",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    }
  }
}
