{
  "expo": {
    "name": "Prime Kids: Parent Helper",
    "slug": "prime-kids-parent-helper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4A90D9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parenthelper.parent",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4A90D9"
      },
      "package": "com.parenthelper.parent",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDCTsWSROklg46X3sd4g7GDAg7ZISNRTj8"
        }
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4A90D9",
          "sounds": [],
          "defaultChannel": "general_alerts"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "ndkVersion": "26.1.10909125",
            "ndkAbiFilters": [
              "arm64-v8a",
              "x86_64"
            ],
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/pin-androidx-core",
      [
        "@sentry/react-native",
        {
          "organization": "parent-helper",
          "project": "parent-app"
        }
      ]
    ]
  }
}
