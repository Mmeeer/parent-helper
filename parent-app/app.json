{
  "expo": {
    "name": "Prime Kids: Parent Helper",
    "slug": "prime-kids-parent-helper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A90D9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parenthelper.parent",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.parenthelper.parent",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDCTsWSROklg46X3sd4g7GDAg7ZISNRTj8"
        }
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4A90D9",
          "sounds": [],
          "defaultChannel": "general_alerts"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "ndkVersion": "27.1.12297006",
            "ndkAbiFilters": [
              "arm64-v8a",
              "x86_64"
            ],
            "usesCleartextTraffic": false
          }
        }
      ],
      "./plugins/pin-androidx-core",
      "./plugins/gradle-memory",
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": ["./assets/fonts/ionicons.ttf"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bf23b024-f537-4624-9b26-727a2e7f5728"
      }
    },
    "owner": "mergenganbat"
  }
}
