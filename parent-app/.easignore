# EAS upload ignore — mirrors .gitignore so the cloud build receives only
# source (EAS runs `expo prebuild` to regenerate android/ from app.json).
# Excluding android/ also avoids copying its locked .gradle cache.

# Expo (regenerated by prebuild in the cloud)
android/
ios/
.expo/

# Dependencies (reinstalled in the cloud)
node_modules/
jspm_packages/
web_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Caches
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache
*.tsbuildinfo

# dotenv environment variable files (secrets — never upload)
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Build output
dist
out
build/Release

# Play submission secret — NEVER upload
google-play-service-account.json

# Misc
*.tgz
.yarn-integrity
coverage
*.lcov
