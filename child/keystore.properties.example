# Copy to keystore.properties (gitignored) and fill in real values.
# The release upload keystore and this file must NEVER be committed.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore app/upload-keystore.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
