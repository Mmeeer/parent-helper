    <string name="location_disclosure_title">Байршлын зөвшөөрөл</string>
    <string name="location_disclosure_message">Prime Kids нь энэ төхөөрөмжийн байршлыг ар талд — апп хаалттай эсвэл ашиглагдаагүй үед ч — цуглуулна. Ингэснээр эцэг эх тань таны байршлыг харж, аюулгүй бүс (гэр, сургууль) рүү ороход эсвэл гарахад мэдэгдэл хүлээн авна. Энэ аппыг эцэг эх тань таны аюулгүй байдлын төлөө суулгасан.\n\nДараагийн алхамд байршлын зөвшөөрлийг асууна. \"Байнга зөвшөөрөх\" (Allow all the time) сонголтыг сонгоно уу.</string>
    <string name="location_disclosure_continue">Үргэлжлүүлэх</string>
    <string name="location_disclosure_cancel">Болих</string>

