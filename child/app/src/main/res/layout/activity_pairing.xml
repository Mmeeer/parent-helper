<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="72dp"
        android:paddingBottom="40dp">

        <!-- Overline label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="PRIME KIDS"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textAllCaps="true" />

        <!-- Shield icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="24dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_shield_check" />

        <!-- Page title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/pairing_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:gravity="center" />

        <!-- Instruction -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="48dp"
            android:gravity="center"
            android:text="@string/pairing_instruction"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <!-- 6-box OTP input row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="36dp">

            <EditText
                android:id="@+id/box1"
                style="@style/CodeBox" />
            <View android:layout_width="8dp" android:layout_height="1dp" />
            <EditText
                android:id="@+id/box2"
                style="@style/CodeBox" />
            <View android:layout_width="8dp" android:layout_height="1dp" />
            <EditText
                android:id="@+id/box3"
                style="@style/CodeBox" />

            <!-- Dash separator -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="6dp"
                android:text="–"
                android:textColor="@color/text_hint"
                android:textSize="22sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/box4"
                style="@style/CodeBox" />
            <View android:layout_width="8dp" android:layout_height="1dp" />
            <EditText
                android:id="@+id/box5"
                style="@style/CodeBox" />
            <View android:layout_width="8dp" android:layout_height="1dp" />
            <EditText
                android:id="@+id/box6"
                style="@style/CodeBox" />

        </LinearLayout>

        <!-- Primary action button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPair"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/pairing_button"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            android:letterSpacing="0.06"
            android:layout_marginBottom="16dp"
            app:cornerRadius="16dp" />

        <!-- OR divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/ink_200" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="@string/pairing_or_divider"
                android:textColor="@color/text_hint"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/ink_200" />
        </LinearLayout>

        <!-- Scan QR button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanQr"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/pairing_scan_qr"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:letterSpacing="0.06"
            android:layout_marginBottom="16dp"
            app:icon="@drawable/ic_qr_code"
            app:iconGravity="textStart"
            app:iconTint="@color/primary"
            app:iconPadding="8dp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.5dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/status_error"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
