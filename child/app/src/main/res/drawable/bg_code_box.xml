<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: primary border, white fill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/primary" />
        </shape>
    </item>
    <!-- Filled (has text): slightly stronger border -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_variant" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="@color/card_border" />
        </shape>
    </item>
</selector>
