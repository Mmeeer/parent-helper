[Unit]
Description=Prime Kids (parent-helper) API — Express + Socket.io (:5003 → https://primekids.masterclass.mn/parent-helper)
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=claude
WorkingDirectory=/root/projects/parent-helper/backend
# PORT, MONGODB_URI, ALLOWED_ORIGINS, etc. come from backend/.env
# (the app calls dotenv.config({override:true}), so .env is authoritative).
#
# SAFETY NET (added after the Jul 2026 outage): backend/.env lives INSIDE the
# git working tree, so a deploy that pulls a commit which untracks/deletes it
# removes the file from the server -> node throws on boot -> systemd restart
# loop -> nginx 502 on every endpoint. That is exactly what happened.
#
# This EnvironmentFile is a copy of the same keys kept OUTSIDE the repo, where
# no git operation can touch it. The leading "-" makes it optional, so the unit
# still starts if the file is absent. Because dotenv runs with override:true,
# backend/.env still wins whenever it exists — this only takes over when the
# in-repo .env has gone missing, turning a hard outage into a no-op.
EnvironmentFile=-/etc/parent-helper/api.env
# All server-side date logic is epoch-based, but logs/emails should read in
# Mongolian time. The real clock-correctness fix is NTP — see backend/OTP_SETUP.md.
Environment=TZ=Asia/Ulaanbaatar
ExecStart=/usr/local/bin/node src/index.js
Restart=always
RestartSec=3
# Logs → journald (journalctl -u parent-helper-api)

[Install]
WantedBy=multi-user.target
