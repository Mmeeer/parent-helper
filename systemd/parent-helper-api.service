[Unit]
Description=Prime Kids (parent-helper) API — Express + Socket.io (:5003 → https://primekids.masterclass.mn/parent-helper)
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User=claude
WorkingDirectory=/root/projects/parent-helper/backend
# PORT, MONGODB_URI, ALLOWED_ORIGINS, etc. come from backend/.env
# (the app calls dotenv.config({override:true}), so .env is authoritative).
ExecStart=/usr/local/bin/node src/index.js
Restart=always
RestartSec=3
# Logs → journald (journalctl -u parent-helper-api)

[Install]
WantedBy=multi-user.target
